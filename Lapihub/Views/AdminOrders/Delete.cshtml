@model Lapihub.ViewModels.AdminOrderListItemViewModel

@{
    ViewData["Title"] = "Изтриване на поръчка";
}

@section Styles {
    <style>
        .admin-side-card,
        .admin-card,
        .warning-box {
            background: #fff;
            border: none;
            border-radius: 1.5rem;
            box-shadow: 0 0.6rem 1.4rem rgba(0, 0, 0, 0.08);
        }

        .admin-nav-list .list-group-item {
            border: none;
            border-radius: 1rem !important;
            margin-bottom: .35rem;
            font-weight: 500;
        }

        .admin-nav-list .list-group-item:hover {
            background: #fff4ea;
        }

        .warning-box {
            background: #fff5f5;
            padding: 1.25rem;
        }
    </style>
}

<div class="mb-4">
    <h1 class="fw-bold mb-2">Изтриване на поръчка</h1>
    <p class="text-muted mb-0">Потвърди дали искаш да изтриеш тази поръчка.</p>
</div>

<div class="row g-4">
    <div class="col-lg-3">
        <partial name="_AdminNavPartial" />
    </div>

    <div class="col-lg-9">
        <div class="card admin-card">
            <div class="card-body p-4">
                <div class="warning-box rounded-4 mb-4">
                    <h5 class="fw-bold text-danger mb-2">Внимание</h5>
                    <p class="mb-0">
                        Наистина ли искаш да изтриеш поръчка <strong>#@Model.Id</strong>?
                    </p>
                </div>

                <div class="mb-4">
                    <div><strong>Клиент:</strong> @Model.CustomerName</div>
                    <div><strong>Имейл:</strong> @Model.CustomerEmail</div>
                    <div><strong>Дата:</strong> @Model.CreatedOn.ToString("dd.MM.yyyy HH:mm")</div>
                    <div><strong>Статус:</strong> @Model.Status</div>
                    <div><strong>Артикули:</strong> @Model.ItemsCount</div>
                    <div><strong>Сума:</strong> @Model.TotalAmount.ToString("F2") лв.</div>
                </div>

                <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()

                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-danger">Изтрий</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Отказ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>