@using Microsoft.AspNetCore.Identity
@using Lapihub.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ЛапиХъб</title>

    <!-- Bootstrap 5 (CDN) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <!-- Bootstrap Icons (CDN) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root{
            --lapihub-cream:#FFF7E6;
            --lapihub-orange:#FF8A3D;
            --lapihub-green:#2FBF71;
            --lapihub-dark:#2B2B2B;
        }
        body { background: var(--lapihub-cream); color: var(--lapihub-dark); }
        .navbar { background: white; }
        .brand-badge{
            background: linear-gradient(90deg, var(--lapihub-orange), var(--lapihub-green));
            color: white;
            border-radius: 999px;
            padding: .35rem .75rem;
            font-weight: 700;
            letter-spacing: .2px;
        }
        footer{
            background: white;
            border-top: 1px solid rgba(0,0,0,.08);
        }
        .btn-lapihub{
            background: var(--lapihub-orange);
            border-color: var(--lapihub-orange);
            color: #fff;
        }
        .btn-lapihub:hover{
            filter: brightness(.95);
            color:#fff;
        }
        .link-lapihub{ color: var(--lapihub-green); }
        .link-lapihub:hover{ color: #239a5a; }

        html, body {
            height: 100%;
        }

        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        main {
            flex: 1;
        }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg shadow-sm">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="brand-badge"><i class="bi bi-heart-fill me-1"></i> ЛапиХъб</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Меню">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Начало</a>
                        </li>
                        <li class="nav-item">
                            <!-- Controller ще го добавим в Phase 3 -->
                            <a class="nav-link" href="#">Продукти</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">Контакти</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                        @if (User?.Identity?.IsAuthenticated ?? false)
                        {
                            <li class="nav-item">
                                <span class="navbar-text">
                                    <i class="bi bi-person-circle me-1"></i> Здравей, потребител
                                </span>
                            </li>
                            <li class="nav-item">
                                <!-- Dashboard ще го добавим в Phase 5 -->
                                <a class="nav-link" href="#">Табло</a>
                            </li>
                            <li class="nav-item">
                                <form class="d-inline" asp-area="Identity" asp-page="/Account/Logout" method="post">
                                    <button type="submit" class="btn btn-outline-dark btn-sm">
                                        Изход
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Вход</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-lapihub btn-sm" asp-area="Identity" asp-page="/Account/Register">
                                    Регистрация
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-fill">
        <div class="container py-4 pb-3">
            @RenderBody()
        </div>
    </main>

    <footer class="py-4">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
            <div>
                <strong>ЛапиХъб</strong> — магазин за консумативи и радост за домашни любимци.
            </div>
            <div class="text-muted">
                © @DateTime.Now.Year — Всички права запазени.
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>