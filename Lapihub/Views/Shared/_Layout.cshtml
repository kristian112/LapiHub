@using Lapihub.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
    var isAdmin = User?.IsInRole("Admin") ?? false;
    var currentUser = isAuthenticated ? await UserManager.GetUserAsync(User) : null;
    var firstName = currentUser?.FirstName ?? "потребител";
}

<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ЛапиХъб</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --lapihub-cream: #FFF7E6;
            --lapihub-orange: #FF8A3D;
            --lapihub-green: #2FBF71;
            --lapihub-dark: #2B2B2B;
        }

        html, body {
            height: 100%;
        }

        body {
            background: var(--lapihub-cream);
            color: var(--lapihub-dark);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        main {
            flex: 1;
        }

        .navbar {
            background: white;
        }

        .brand-badge {
            background: linear-gradient(90deg, var(--lapihub-orange), var(--lapihub-green));
            color: white;
            border-radius: 999px;
            padding: .35rem .75rem;
            font-weight: 700;
            letter-spacing: .2px;
        }

        footer {
            background: white;
            border-top: 1px solid rgba(0,0,0,.08);
        }

        .btn-lapihub {
            background: var(--lapihub-orange);
            border-color: var(--lapihub-orange);
            color: #fff;
        }

        .btn-lapihub:hover {
            filter: brightness(.95);
            color: #fff;
        }

        .navbar .nav-link {
            font-weight: 500;
        }

        .hello-text {
            font-weight: 600;
            color: var(--lapihub-green);
        }

        .dropdown-menu {
            border: none;
            border-radius: 1rem;
            box-shadow: 0 0.75rem 1.5rem rgba(0,0,0,.08);
        }

        .dropdown-item:active {
            background-color: var(--lapihub-green);
        }

        .nav-item.dropdown {
            position: relative;
        }

            .nav-item.dropdown .dropdown-menu {
                margin-top: .5rem;
            }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg shadow-sm">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="brand-badge">
                        <i class="bi bi-heart-fill me-1"></i> ЛапиХъб
                    </span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Меню">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Начало</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Products" asp-action="Index">Продукти</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Contacts">Контакти</a>
                        </li>

                        @if (isAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Dashboard" asp-action="Index">Табло</a>
                            </li>
                        }

                        @if (isAdmin)
                        {
                            <li class="nav-item dropdown position-relative">
                                <a class="nav-link dropdown-toggle" href="#" id="adminDropdown" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    Администриране
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="adminDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Index">
                                            Админ табло
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="AdminProducts" asp-action="Index">
                                            Управление на продукти
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="AdminCategories" asp-action="Index">
                                            Управление на категории
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="AdminOrders" asp-action="Index">
                                            Управление на поръчки
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="AdminUsers" asp-action="Index">
                                            Управление на потребители
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                        @if (isAuthenticated)
                        {
                            <li class="nav-item">
                                <span class="navbar-text hello-text">
                                    <i class="bi bi-person-circle me-1"></i> Здравей, @firstName
                                </span>
                            </li>

                            <li class="nav-item">
                                <form class="d-inline" asp-area="Identity" asp-page="/Account/Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-dark btn-sm">
                                        Изход
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Вход</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-lapihub btn-sm" asp-area="Identity" asp-page="/Account/Register">
                                    Регистрация
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-fill">
        <div class="container py-4 pb-3">
            @RenderBody()
        </div>
    </main>

    <footer class="py-4 mt-auto">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
            <div>
                <strong>ЛапиХъб</strong> — магазин за консумативи и радост за домашни любимци.
            </div>
            <div class="text-muted">
                © @DateTime.Now.Year — Всички права запазени.
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>