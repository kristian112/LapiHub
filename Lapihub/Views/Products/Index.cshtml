@model Lapihub.ViewModels.ProductIndexViewModel

@{
    ViewData["Title"] = "Продукти";
}

@section Styles {
    <style>
        .filter-card,
        .product-card,
        .brand-widget {
            background: #fff;
            border: none;
            border-radius: 1.25rem;
            box-shadow: 0 0.5rem 1.2rem rgba(0, 0, 0, 0.08);
        }

        .product-card {
            overflow: hidden;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            height: 100%;
        }

            .product-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 0.8rem 1.5rem rgba(0, 0, 0, 0.12);
            }

        .product-image {
            height: 220px;
            object-fit: cover;
            width: 100%;
        }

        .sidebar-title {
            font-weight: 700;
            margin-bottom: 1rem;
        }

        .price-text {
            color: #ff8a3d;
            font-weight: 700;
            font-size: 1.15rem;
        }

        .brand-count-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: .45rem 0;
            border-bottom: 1px solid #f1f1f1;
        }

            .brand-count-item:last-child {
                border-bottom: none;
            }

        .empty-state {
            background: #fff;
            border-radius: 1.25rem;
            box-shadow: 0 0.5rem 1.2rem rgba(0, 0, 0, 0.08);
            padding: 3rem 1.5rem;
            text-align: center;
        }
    </style>
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="fw-bold mb-1">Продукти</h1>
        <p class="text-muted mb-0">Открий подходящите продукти за твоя любимец.</p>
    </div>
</div>

@if (TempData["InfoMessage"] != null)
{
    <div class="alert alert-info rounded-4">
        @TempData["InfoMessage"]
    </div>
}

<div class="row g-4">
    <div class="col-lg-3">
        <div class="filter-card p-4 mb-4">
            <h4 class="sidebar-title">Филтри</h4>

            <form method="get" asp-action="Index">
                <div class="mb-3">
                    <label class="form-label">Търсене</label>
                    <input asp-for="SearchTerm" class="form-control" placeholder="Име или марка" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Категория</label>
                    <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                        <option value="">Всички категории</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Марка</label>
                    <select asp-for="Brand" class="form-select">
                        <option value="">Всички марки</option>
                        @foreach (var brand in Model.Brands)
                        {
                            <option value="@brand">@brand</option>
                        }
                    </select>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label">Цена от</label>
                        <input asp-for="MinPrice" class="form-control" type="number" step="0.01" min="0" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Цена до</label>
                        <input asp-for="MaxPrice" class="form-control" type="number" step="0.01" min="0" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Сортиране</label>
                    <select asp-for="SortBy" class="form-select">
                        <option value="">Име (А-Я)</option>
                        <option value="name_desc">Име (Я-А)</option>
                        <option value="price_asc">Цена (възходящо)</option>
                        <option value="price_desc">Цена (низходящо)</option>
                    </select>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-lapihub">Приложи</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Изчисти</a>
                </div>
            </form>
        </div>

        <div class="brand-widget p-4">
            <h5 class="sidebar-title mb-3">Брой продукти по марки</h5>

            @if (Model.BrandCounts.Any())
            {
                @foreach (var item in Model.BrandCounts)
                {
                    <div class="brand-count-item">
                        <span>@item.Brand</span>
                        <span class="badge bg-success rounded-pill">@item.Count</span>
                    </div>
                }
            }
            else
            {
                <p class="text-muted mb-0">Няма налични марки.</p>
            }
        </div>
    </div>

    <div class="col-lg-9">
        @if (Model.Products.Any())
        {
            <div class="row g-4">
                @foreach (var product in Model.Products)
                {
                    <div class="col-md-6 col-xl-4">
                        <div class="card product-card">
                            <img src="@product.ImageUrl" class="product-image" alt="@product.Name" />

                            <div class="card-body d-flex flex-column">
                                <div class="mb-2">
                                    <h5 class="card-title fw-bold">@product.Name</h5>
                                    <div class="text-muted small">Марка: @product.Brand</div>
                                    <div class="text-muted small">Категория: @product.Category?.Name</div>
                                </div>

                                <div class="mt-auto">
                                    <div class="price-text mb-3">@product.Price.ToString("F2") лв.</div>

                                    <div class="d-grid gap-2">
                                        <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-dark">
                                            Детайли
                                        </a>

                                        <form asp-action="AddToCart" asp-route-id="@product.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                            <button type="submit" class="btn btn-lapihub w-100">
                                                Добави в количката
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="display-5 mb-3">🐾</div>
                <h3 class="fw-bold">Няма намерени продукти</h3>
                <p class="text-muted mb-3">
                    Опитай с различни филтри, марка, категория или ценови диапазон.
                </p>
                <a asp-action="Index" class="btn btn-lapihub">Покажи всички продукти</a>
            </div>
        }
    </div>
</div>