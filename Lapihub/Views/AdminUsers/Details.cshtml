@model Lapihub.ViewModels.AdminUserDetailsViewModel

@{
    ViewData["Title"] = "Детайли за потребител";
}

@section Styles {
    <style>
        .admin-side-card,
        .admin-card,
        .info-box {
            background: #fff;
            border: none;
            border-radius: 1.5rem;
            box-shadow: 0 0.6rem 1.4rem rgba(0, 0, 0, 0.08);
        }

        .admin-nav-list .list-group-item {
            border: none;
            border-radius: 1rem !important;
            margin-bottom: .35rem;
            font-weight: 500;
        }

            .admin-nav-list .list-group-item:hover {
                background: #fff4ea;
            }

        .info-box {
            padding: 1.2rem;
            height: 100%;
        }

        .info-label {
            color: #6c757d;
            margin-bottom: .35rem;
        }

        .info-value {
            font-weight: 700;
        }

        .role-badge {
            background: #eefcf2;
            color: #2f8f5b;
            padding: 0.45rem 0.8rem;
            border-radius: 999px;
            font-size: 0.9rem;
            font-weight: 600;
            display: inline-block;
        }

            .role-badge.admin {
                background: #fff3e6;
                color: #d97706;
            }
    </style>
}

<div class="mb-4">
    <h1 class="fw-bold mb-2">Детайли за потребител</h1>
    <p class="text-muted mb-0">Пълен преглед на информацията за избрания потребител.</p>
</div>

<div class="row g-4">
    <div class="col-lg-3">
        <partial name="_AdminNavPartial" />
    </div>

    <div class="col-lg-9">
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="info-box">
                    <div class="info-label">Име</div>
                    <div class="info-value">@Model.FirstName</div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <div class="info-label">Фамилия</div>
                    <div class="info-value">@Model.LastName</div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <div class="info-label">Имейл</div>
                    <div class="info-value">@Model.Email</div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <div class="info-label">Телефон</div>
                    <div class="info-value">@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "-" : Model.PhoneNumber)</div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="info-box">
                    <div class="info-label">Роля</div>
                    <div class="info-value">
                        <span class="role-badge @(Model.IsAdmin ? "admin" : "")">
                            @(Model.IsAdmin ? "Админ" : "Потребител")
                        </span>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="info-box">
                    <div class="info-label">Брой поръчки</div>
                    <div class="info-value">@Model.OrdersCount</div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="info-box">
                    <div class="info-label">Продукти в количката</div>
                    <div class="info-value">@Model.CartItemsCount</div>
                </div>
            </div>
        </div>

        <div class="card admin-card">
            <div class="card-body p-4">
                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-lapihub">Редактирай</a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Изтрий</a>
                    <a asp-action="Index" class="btn btn-outline-secondary">Назад</a>
                </div>
            </div>
        </div>
    </div>
</div>