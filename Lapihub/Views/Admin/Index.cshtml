@model Lapihub.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Админ табло";
}

@section Styles {
    <style>
        .admin-page-title {
            font-weight: 800;
        }

        .admin-side-card,
        .admin-card,
        .admin-stat-card {
            background: #fff;
            border: none;
            border-radius: 1.5rem;
            box-shadow: 0 0.6rem 1.4rem rgba(0, 0, 0, 0.08);
        }

        .admin-nav-list .list-group-item {
            border: none;
            border-radius: 1rem !important;
            margin-bottom: .35rem;
            font-weight: 500;
        }

            .admin-nav-list .list-group-item:hover {
                background: #fff4ea;
            }

        .admin-stat-card {
            padding: 1.5rem;
            height: 100%;
        }

        .admin-stat-icon {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #fff3e6;
            color: #ff8a3d;
            font-size: 1.4rem;
            margin-bottom: 1rem;
        }

        .admin-stat-value {
            font-size: 2rem;
            font-weight: 800;
            line-height: 1;
        }

        .admin-stat-label {
            color: #6c757d;
            margin-top: .35rem;
        }

        .admin-info-box {
            background: linear-gradient(135deg, #fff1e7, #eefcf2);
            border-radius: 1.5rem;
            padding: 2rem;
        }
    </style>
}

<div class="mb-4">
    <h1 class="admin-page-title mb-2">Админ табло</h1>
    <p class="text-muted mb-0">Управлявай съдържанието и следи основните данни на ЛапиХъб.</p>
</div>

<div class="row g-4">
    <div class="col-lg-3">
        <partial name="_AdminNavPartial" />
    </div>

    <div class="col-lg-9">
        <div class="admin-info-box shadow-sm mb-4">
            <div class="row align-items-center g-3">
                <div class="col-md-8">
                    <h2 class="fw-bold mb-2">Добре дошъл в админ панела</h2>
                    <p class="mb-0 text-muted">
                        Оттук можеш да управляваш продукти, категории, поръчки и потребители.
                    </p>
                </div>
                <div class="col-md-4 text-md-end">
                    <div class="display-5">⚙️</div>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-md-6 col-xl-3">
                <div class="admin-stat-card">
                    <div class="admin-stat-icon">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <div class="admin-stat-value">@Model.ProductsCount</div>
                    <div class="admin-stat-label">Продукти</div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="admin-stat-card">
                    <div class="admin-stat-icon">
                        <i class="bi bi-tags"></i>
                    </div>
                    <div class="admin-stat-value">@Model.CategoriesCount</div>
                    <div class="admin-stat-label">Категории</div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="admin-stat-card">
                    <div class="admin-stat-icon">
                        <i class="bi bi-receipt"></i>
                    </div>
                    <div class="admin-stat-value">@Model.OrdersCount</div>
                    <div class="admin-stat-label">Поръчки</div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="admin-stat-card">
                    <div class="admin-stat-icon">
                        <i class="bi bi-people"></i>
                    </div>
                    <div class="admin-stat-value">@Model.UsersCount</div>
                    <div class="admin-stat-label">Потребители</div>
                </div>
            </div>
        </div>

        <div class="card admin-card">
            <div class="card-body p-4">
                <h3 class="fw-bold mb-3">Бързи действия</h3>

                <div class="d-flex flex-wrap gap-2">
                    <a asp-controller="AdminProducts" asp-action="Index" class="btn btn-lapihub">
                        Към продуктите
                    </a>
                    <a asp-controller="AdminCategories" asp-action="Index" class="btn btn-outline-dark">
                        Към категориите
                    </a>
                    <a asp-controller="AdminOrders" asp-action="Index" class="btn btn-outline-dark">
                        Към поръчките
                    </a>
                    <a asp-controller="AdminUsers" asp-action="Index" class="btn btn-outline-dark">
                        Към потребителите
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>