@model IEnumerable<Lapihub.ViewModels.AdminProductDetailsViewModel>

@{
    ViewData["Title"] = "Управление на продукти";
}

@section Styles {
    <style>
        .admin-side-card,
        .admin-card {
            background: #fff;
            border: none;
            border-radius: 1.5rem;
            box-shadow: 0 0.6rem 1.4rem rgba(0, 0, 0, 0.08);
        }

        .admin-nav-list .list-group-item {
            border: none;
            border-radius: 1rem !important;
            margin-bottom: .35rem;
            font-weight: 500;
        }

            .admin-nav-list .list-group-item:hover {
                background: #fff4ea;
            }

        .product-thumb {
            width: 64px;
            height: 64px;
            object-fit: cover;
            border-radius: .9rem;
        }
    </style>
}

<div class="mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 class="fw-bold mb-2">Управление на продукти</h1>
        <p class="text-muted mb-0">Създавай, редактирай и премахвай продукти в ЛапиХъб.</p>
    </div>
    <a asp-action="Create" class="btn btn-lapihub">Добави продукт</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success rounded-4">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger rounded-4">
        @TempData["ErrorMessage"]
    </div>
}

<div class="row g-4">
    <div class="col-lg-3">
        <partial name="_AdminNavPartial" />
    </div>

    <div class="col-lg-9">
        <div class="card admin-card">
            <div class="card-body p-4">
                @if (Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Снимка</th>
                                    <th>Име</th>
                                    <th>Марка</th>
                                    <th>Категория</th>
                                    <th>Цена</th>
                                    <th class="text-end">Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var product in Model)
                                {
                                    <tr>
                                        <td>
                                            <img src="@product.ImageUrl" alt="@product.Name" class="product-thumb" />
                                        </td>
                                        <td>@product.Name</td>
                                        <td>@product.Brand</td>
                                        <td>@product.CategoryName</td>
                                        <td>@product.Price.ToString("F2") лв.</td>
                                        <td class="text-end">
                                            <div class="d-flex justify-content-end gap-2 flex-wrap">
                                                <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-dark btn-sm">Детайли</a>
                                                <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-outline-primary btn-sm">Редактирай</a>
                                                <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-outline-danger btn-sm">Изтрий</a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <div class="display-6 mb-3">📦</div>
                        <h3 class="fw-bold">Няма добавени продукти</h3>
                        <p class="text-muted mb-4">Започни, като добавиш първия продукт.</p>
                        <a asp-action="Create" class="btn btn-lapihub">Добави продукт</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>