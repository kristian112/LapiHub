@model Lapihub.ViewModels.OrderDetailsViewModel

@{
    ViewData["Title"] = "Детайли за поръчка";
}

@section Styles {
    <style>
        .details-card,
        .summary-card {
            background: #fff;
            border: none;
            border-radius: 1.5rem;
            box-shadow: 0 0.6rem 1.4rem rgba(0,0,0,.08);
        }

        .product-image {
            width: 72px;
            height: 72px;
            object-fit: cover;
            border-radius: 0.9rem;
        }

        .status-badge {
            background: #eefcf2;
            color: #2f8f5b;
            padding: 0.45rem 0.8rem;
            border-radius: 999px;
            font-size: 0.9rem;
            font-weight: 600;
            display: inline-block;
        }

        .grand-total {
            color: #ff8a3d;
            font-size: 1.4rem;
            font-weight: 700;
        }

        .summary-box {
            background: #fffaf2;
            border-radius: 1rem;
            padding: 1rem 1.15rem;
            height: 100%;
        }
    </style>
}

<div class="mb-4">
    <a asp-action="MyOrders" class="btn btn-outline-secondary">← Обратно към поръчките</a>
</div>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="fw-bold mb-1">Поръчка #@Model.Id</h1>
        <p class="text-muted mb-0">Създадена на @Model.CreatedOn.ToString("dd.MM.yyyy HH:mm")</p>
    </div>
    <div>
        <span class="status-badge">@Model.Status</span>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="summary-box">
            <div class="text-muted small mb-2">Адрес</div>
            <div class="fw-semibold">@Model.Address</div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="summary-box">
            <div class="text-muted small mb-2">Телефон</div>
            <div class="fw-semibold">@Model.PhoneNumber</div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="summary-box">
            <div class="text-muted small mb-2">Метод на плащане</div>
            <div class="fw-semibold">@Model.PaymentMethod</div>
        </div>
    </div>
</div>

<div class="card details-card mb-4">
    <div class="card-body p-4">
        <h3 class="fw-bold mb-4">Продукти в поръчката</h3>

        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Продукт</th>
                        <th>Марка</th>
                        <th>Количество</th>
                        <th>Единична цена</th>
                        <th>Общо</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@item.ImageUrl" alt="@item.ProductName" class="product-image" />
                                    <div>@item.ProductName</div>
                                </div>
                            </td>
                            <td>@item.Brand</td>
                            <td>@item.Quantity</td>
                            <td>@item.Price.ToString("F2") лв.</td>
                            <td class="fw-bold">@item.LineTotal.ToString("F2") лв.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card summary-card">
    <div class="card-body p-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="fw-semibold">Крайна сума</div>
        <div class="grand-total">@Model.TotalAmount.ToString("F2") лв.</div>
    </div>
</div>