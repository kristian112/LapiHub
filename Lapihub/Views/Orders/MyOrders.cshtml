@model IEnumerable<Lapihub.ViewModels.MyOrderListItemViewModel>

@{
    ViewData["Title"] = "Моите поръчки";
}

@section Styles {
    <style>
        .orders-card,
        .empty-orders {
            background: #fff;
            border: none;
            border-radius: 1.5rem;
            box-shadow: 0 0.6rem 1.4rem rgba(0,0,0,.08);
        }

        .status-badge {
            background: #eefcf2;
            color: #2f8f5b;
            padding: 0.45rem 0.8rem;
            border-radius: 999px;
            font-size: 0.9rem;
            font-weight: 600;
            display: inline-block;
        }

        .order-total {
            color: #ff8a3d;
            font-weight: 700;
        }
    </style>
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="fw-bold mb-1">Моите поръчки</h1>
        <p class="text-muted mb-0">Преглед на всички направени поръчки.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success rounded-4">
        @TempData["SuccessMessage"]
    </div>
}

@if (Model.Any())
{
    <div class="card orders-card">
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>№ Поръчка</th>
                            <th>Дата</th>
                            <th>Статус</th>
                            <th>Артикули</th>
                            <th>Обща сума</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td>#@order.Id</td>
                                <td>@order.CreatedOn.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    <span class="status-badge">@order.Status</span>
                                </td>
                                <td>@order.ItemsCount</td>
                                <td class="order-total">@order.TotalAmount.ToString("F2") лв.</td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-outline-dark btn-sm">
                                        Детайли
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="card empty-orders">
        <div class="card-body p-5 text-center">
            <div class="display-5 mb-3">📦</div>
            <h2 class="fw-bold mb-3">Все още нямате поръчки</h2>
            <p class="text-muted mb-4">
                Когато направите първата си поръчка, тя ще се появи тук.
            </p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-lapihub px-4">
                Към продуктите
            </a>
        </div>
    </div>
}