@{
    ViewData["Title"] = "Начало";
}

@section Styles {
    <style>
        .hero-carousel img {
            height: 500px;
            object-fit: cover;
            border-radius: 1.5rem;
        }

        .carousel-caption-custom {
            background: rgba(0, 0, 0, 0.45);
            border-radius: 1rem;
            padding: 1.25rem;
            max-width: 520px;
        }

        .section-card {
            background: #ffffff;
            border: none;
            border-radius: 1.25rem;
            box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.08);
            transition: transform 0.2s ease;
            height: 100%;
        }

        .section-card:hover {
            transform: translateY(-4px);
        }

        .paw-badge {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            background: #fff3e6;
            color: #ff8a3d;
        }

        .welcome-box {
            background: linear-gradient(135deg, #fff8ea, #f2fff4);
            border-radius: 1.5rem;
            padding: 2rem;
        }

        .cta-box {
            background: linear-gradient(135deg, #ffeddc, #eefcf2);
            border-radius: 1.5rem;
            padding: 2rem;
        }
    </style>
}

<div class="container px-0">
    <div id="homeCarousel" class="carousel slide hero-carousel mb-5" data-bs-ride="carousel">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#homeCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Слайд 1"></button>
            <button type="button" data-bs-target="#homeCarousel" data-bs-slide-to="1" aria-label="Слайд 2"></button>
            <button type="button" data-bs-target="#homeCarousel" data-bs-slide-to="2" aria-label="Слайд 3"></button>
        </div>

        <div class="carousel-inner rounded-4 overflow-hidden shadow">
            <div class="carousel-item active">
                <img src="https://images.unsplash.com/photo-1517849845537-4d257902454a?auto=format&fit=crop&w=1400&q=80" class="d-block w-100" alt="Щастливо куче">
                <div class="carousel-caption text-start d-flex justify-content-start align-items-end h-100 pb-5">
                    <div class="carousel-caption-custom">
                        <h1 class="display-6 fw-bold">Всичко за щастливи лапички</h1>
                        <p class="mb-3">Открий качествена храна, играчки, лакомства и аксесоари за твоите любимци.</p>
                        <a href="/Products" class="btn btn-lapihub">Разгледай продуктите</a>
                    </div>
                </div>
            </div>

            <div class="carousel-item">
                <img src="https://images.unsplash.com/photo-1519052537078-e6302a4968d4?auto=format&fit=crop&w=1400&q=80" class="d-block w-100" alt="Котка">
                <div class="carousel-caption text-start d-flex justify-content-start align-items-end h-100 pb-5">
                    <div class="carousel-caption-custom">
                        <h2 class="fw-bold">Подбрани марки и грижа с характер</h2>
                        <p class="mb-3">В ЛапиХъб събираме любими продукти за кучета и котки на едно място.</p>
                        <a href="/Products" class="btn btn-lapihub">Към каталога</a>
                    </div>
                </div>
            </div>

            <div class="carousel-item">
                <img src="https://images.unsplash.com/photo-1548199973-03cce0bbc87b?auto=format&fit=crop&w=1400&q=80" class="d-block w-100" alt="Домашен любимец">
                <div class="carousel-caption text-start d-flex justify-content-start align-items-end h-100 pb-5">
                    <div class="carousel-caption-custom">
                        <h2 class="fw-bold">Уют, игра и грижа всеки ден</h2>
                        <p class="mb-3">Избери продукти, които правят ежедневието на любимеца ти по-забавно и по-комфортно.</p>
                        <a href="/Products" class="btn btn-lapihub">Пазарувай сега</a>
                    </div>
                </div>
            </div>
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#homeCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Назад</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#homeCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Напред</span>
        </button>
    </div>

    <section class="welcome-box mb-5 shadow-sm">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <h2 class="fw-bold mb-3">Добре дошли в ЛапиХъб</h2>
                <p class="lead mb-3">
                    Тук ще намериш внимателно подбрани продукти за кучета и котки — от храна и лакомства
                    до играчки, аксесоари и ежедневна грижа.
                </p>
                <p class="mb-0 text-muted">
                    Нашата мисия е проста: да помагаме на стопаните да избират по-лесно, а любимците да получават повече комфорт, радост и внимание.
                </p>
            </div>
            <div class="col-lg-5 text-center">
                <div class="display-1">🐶🐱</div>
                <p class="fw-semibold mb-0">Място за всичко важно за твоя любимец.</p>
            </div>
        </div>
    </section>

    <section class="mb-5">
        <div class="text-center mb-4">
            <h2 class="fw-bold">Защо да изберете нас</h2>
            <p class="text-muted mb-0">ЛапиХъб комбинира удобство, стил и грижа за домашните любимци.</p>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="card section-card p-4 text-center">
                    <div class="paw-badge mx-auto mb-3">
                        <i class="bi bi-bag-heart-fill"></i>
                    </div>
                    <h5 class="fw-bold">Подбрани продукти</h5>
                    <p class="text-muted mb-0">
                        Предлагаме разнообразие от храни, играчки, аксесоари и продукти за грижа.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card section-card p-4 text-center">
                    <div class="paw-badge mx-auto mb-3">
                        <i class="bi bi-stars"></i>
                    </div>
                    <h5 class="fw-bold">Модерен и удобен избор</h5>
                    <p class="text-muted mb-0">
                        Бързо намираш това, което ти трябва, с ясен каталог и приятен дизайн.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card section-card p-4 text-center">
                    <div class="paw-badge mx-auto mb-3">
                        <i class="bi bi-heart-pulse-fill"></i>
                    </div>
                    <h5 class="fw-bold">Грижа с внимание</h5>
                    <p class="text-muted mb-0">
                        Всеки продукт е част от по-добро ежедневие за твоя домашен любимец.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card section-card p-4 text-center">
                    <div class="paw-badge mx-auto mb-3">
                        <i class="bi bi-truck"></i>
                    </div>
                    <h5 class="fw-bold">Лесна поръчка</h5>
                    <p class="text-muted mb-0">
                        От количка до поръчка — всичко е направено да става бързо и ясно.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <section class="cta-box shadow-sm">
        <div class="row align-items-center g-4">
            <div class="col-lg-8">
                <h2 class="fw-bold mb-2">Готов ли си да зарадваш своя любимец?</h2>
                <p class="text-muted mb-0">
                    Разгледай каталога на ЛапиХъб и избери продукти, които носят повече комфорт, игра и вкусни моменти.
                </p>
            </div>
            <div class="col-lg-4 text-lg-end">
                <a href="/Products" class="btn btn-lapihub btn-lg px-4">
                    Към продуктите
                </a>
            </div>
        </div>
    </section>
</div>