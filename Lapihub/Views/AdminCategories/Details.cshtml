@model Lapihub.ViewModels.AdminCategoryDetailsViewModel

@{
    ViewData["Title"] = "Детайли за категория";
}

@section Styles {
    <style>
        .admin-side-card,
        .admin-card,
        .info-box {
            background: #fff;
            border: none;
            border-radius: 1.5rem;
            box-shadow: 0 0.6rem 1.4rem rgba(0, 0, 0, 0.08);
        }

        .admin-nav-list .list-group-item {
            border: none;
            border-radius: 1rem !important;
            margin-bottom: .35rem;
            font-weight: 500;
        }

            .admin-nav-list .list-group-item:hover {
                background: #fff4ea;
            }

        .info-box {
            padding: 1.25rem;
        }

        .info-label {
            color: #6c757d;
            margin-bottom: .4rem;
        }

        .info-value {
            font-size: 1.15rem;
            font-weight: 700;
        }
    </style>
}

<div class="mb-4">
    <h1 class="fw-bold mb-2">Детайли за категория</h1>
    <p class="text-muted mb-0">Преглед на информацията за избраната категория.</p>
</div>

<div class="row g-4">
    <div class="col-lg-3">
        <partial name="_AdminNavPartial" />
    </div>

    <div class="col-lg-9">
        <div class="card admin-card">
            <div class="card-body p-4">
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="info-box">
                            <div class="info-label">Име</div>
                            <div class="info-value">@Model.Name</div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="info-box">
                            <div class="info-label">Брой продукти</div>
                            <div class="info-value">@Model.ProductsCount</div>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-lapihub">Редактирай</a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Изтрий</a>
                    <a asp-action="Index" class="btn btn-outline-secondary">Назад</a>
                </div>
            </div>
        </div>
    </div>
</div>