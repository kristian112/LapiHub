@model IEnumerable<Lapihub.ViewModels.AdminCategoryDetailsViewModel>

@{
    ViewData["Title"] = "Управление на категории";
}

@section Styles {
    <style>
        .admin-side-card,
        .admin-card {
            background: #fff;
            border: none;
            border-radius: 1.5rem;
            box-shadow: 0 0.6rem 1.4rem rgba(0, 0, 0, 0.08);
        }

        .admin-nav-list .list-group-item {
            border: none;
            border-radius: 1rem !important;
            margin-bottom: .35rem;
            font-weight: 500;
        }

            .admin-nav-list .list-group-item:hover {
                background: #fff4ea;
            }
    </style>
}

<div class="mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 class="fw-bold mb-2">Управление на категории</h1>
        <p class="text-muted mb-0">Създавай, преглеждай, редактирай и изтривай категории.</p>
    </div>
    <a asp-action="Create" class="btn btn-lapihub">Добави категория</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success rounded-4">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger rounded-4">
        @TempData["ErrorMessage"]
    </div>
}

<div class="row g-4">
    <div class="col-lg-3">
        <partial name="_AdminNavPartial" />
    </div>

    <div class="col-lg-9">
        <div class="card admin-card">
            <div class="card-body p-4">
                @if (Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Име</th>
                                    <th>Брой продукти</th>
                                    <th class="text-end">Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var category in Model)
                                {
                                    <tr>
                                        <td>@category.Name</td>
                                        <td>@category.ProductsCount</td>
                                        <td class="text-end">
                                            <div class="d-flex justify-content-end gap-2 flex-wrap">
                                                <a asp-action="Details" asp-route-id="@category.Id" class="btn btn-outline-dark btn-sm">Детайли</a>
                                                <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-outline-primary btn-sm">Редактирай</a>
                                                <a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-outline-danger btn-sm">Изтрий</a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <div class="display-6 mb-3">🏷️</div>
                        <h3 class="fw-bold">Няма добавени категории</h3>
                        <p class="text-muted mb-4">Започни, като създадеш първата категория.</p>
                        <a asp-action="Create" class="btn btn-lapihub">Добави категория</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>